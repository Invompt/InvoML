{
  "name": "invoml",
  "version": "1.0.0-alpha.21",
  "description": "InvoML — Invoice Markup Language: parse, validate, calculate, format, and render invoices",
  "type": "module",
  "packageManager": "npm@11.11.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./calculator": {
      "types": "./dist/src/calculator.d.ts",
      "import": "./dist/src/calculator.js"
    },
    "./html-renderer": {
      "types": "./dist/src/html-renderer.d.ts",
      "import": "./dist/src/html-renderer.js"
    },
    "./html-css": {
      "types": "./dist/src/html-css.d.ts",
      "import": "./dist/src/html-css.js"
    },
    "./presentation": {
      "types": "./dist/src/presentation.d.ts",
      "import": "./dist/src/presentation.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js"
    },
    "./validator": {
      "types": "./dist/src/validator.d.ts",
      "import": "./dist/src/validator.js"
    },
    "./validation": {
      "types": "./dist/src/validation.d.ts",
      "import": "./dist/src/validation.js"
    },
    "./mutators": {
      "types": "./dist/src/mutators.d.ts",
      "import": "./dist/src/mutators.js"
    },
    "./format": {
      "types": "./dist/src/format.d.ts",
      "import": "./dist/src/format.js"
    },
    "./locale": {
      "types": "./dist/src/locale.d.ts",
      "import": "./dist/src/locale.js"
    },
    "./themes": {
      "types": "./dist/src/themes.d.ts",
      "import": "./dist/src/themes.js"
    },
    "./invoml-v1.0.schema.json": "./invoml-v1.0.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "invoml-v1.0.schema.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "invoml": "dist/cli/invoml.js"
  },
  "scripts": {
    "check:lock": "node scripts/assert-lock-integrity.mjs",
    "check:privacy": "node scripts/assert-privacy.mjs --source .",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:functional": "vitest run tests/functional.test.ts",
    "test:release-gate": "vitest run tests/release-gate.test.ts",
    "test:watch": "vitest",
    "cli": "tsx cli/invoml.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Invompt/InvoML"
  },
  "homepage": "https://github.com/invompt/InvoML",
  "bugs": {
    "url": "https://github.com/invompt/InvoML/issues"
  },
  "keywords": [
    "invoice",
    "invoml",
    "invoice-markup-language",
    "ai",
    "structured-output",
    "json-schema",
    "billing",
    "tax"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "18.19.130",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.0",
    "decimal.js": "^10.6.0"
  },
  "overrides": {
    "@types/node": "18.19.130"
  }
}
